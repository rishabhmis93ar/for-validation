<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Express Validation Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card p-4 shadow border-0" style="width: 100%; max-width: 400px;">
        <h2 class="text-center mb-4 text-dark fw-bold">Registration Form</h2>
        
        <% if(errors && errors.length > 0) { %>
            <div class="alert alert-danger p-2" role="alert">
                <ul class="mb-0 ps-3" style="font-size: 14px;">
                    <% errors.forEach(error => { %>
                        <li><%= error.msg %></li> 
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <form action="/saveform" method="POST">
            
            <div class="mb-3">
                <label for="username" class="form-label fw-semibold text-secondary">Full Name</label>
                <input type="text" class="form-control" id="username" name="username" >
            </div>

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold text-secondary">Email Address</label>
                <input type="email" class="form-control" id="email" name="useremail" >
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-semibold text-secondary">Password</label>
                <input type="password" class="form-control" id="password" name="userpass" >
            </div>

            <div class="mb-3">
                <label for="age" class="form-label fw-semibold text-secondary">Age</label>
                <input type="number" class="form-control" id="age" name="userage">
            </div>

            <div class="mb-4">
                <label for="city" class="form-label fw-semibold text-secondary">City</label>
                <select class="form-select" id="city" name="usercity">
                    <option value="">-- Select Your City --</option>
                    <option value="Delhi">Delhi</option>
                    <option value="Mumbai">Mumbai</option>
                    <option value="Banglore">Bangalore</option>
                    <option value="Pune">Pune</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Submit Details</button>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>